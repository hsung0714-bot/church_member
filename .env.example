# 이 프로젝트를 실행하려면 아래 환경변수를 채운 .env 파일이 필요합니다.
# server/_core/env.ts 참고

# tRPC/클라이언트에서 사용하는 앱 식별자
VITE_APP_ID=

# 세션 쿠키 서명에 사용하는 비밀키
JWT_SECRET=

# MySQL 연결 문자열 (drizzle-orm/mysql2)
# 예: mysql://user:password@host:3306/dbname
DATABASE_URL=

# OAuth 로그인에 사용하는 인증 서버 URL
OAUTH_SERVER_URL=

# 최초 로그인 시 자동으로 admin 권한을 부여할 프로젝트 소유자의 openId
OWNER_OPEN_ID=

# 파일 업로드(Forge/S3 presigned URL)에 사용하는 API 엔드포인트와 키
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
