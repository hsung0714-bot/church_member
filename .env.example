# 이 프로젝트를 실행하려면 아래 환경변수를 채운 .env 파일이 필요합니다.
# server/_core/env.ts 참고

# 세션 쿠키(JWT) 서명에 사용하는 비밀키. 32자 이상의 임의 문자열을 넣으세요.
# 예: openssl rand -hex 32
JWT_SECRET=

# MySQL 연결 문자열 (drizzle-orm/mysql2)
# docker-compose.yml로 로컬 MySQL을 띄웠다면:
# mysql://root:church_member_dev@localhost:3306/church_member
DATABASE_URL=
